# Gradle / Android build output
.gradle/
.kotlin/
build/
!gradle/wrapper/gradle-wrapper.jar
local.properties
*.iml
.idea/
.cxx/
captures/
*.hprof

# Private signing material never goes in the repo. The PUBLIC dev key in signing/dev/ is the one intentional exception (owner decision 2026-11-17).
keystore.properties
*.jks
*.keystore
*.p12
*.pem
*.key
!signing/dev/*.p12
!signing/dev/*.jks
.env
.env.*

# The owner's PRIVATE typing data (plan 11.6): learning exports, personal model files, replay logs, snapshots. Never committed.
personal/
replay/
owner-data/
*.journal
*.snap
*.replay
glide_personal.txt
own_words.txt
# (a documented example lives in docs/KEYBOARD-EXPORT.md; test fixtures live under */src/test/)

# APKs are built by GitHub Actions and published as Release assets: never commit one
*.apk
*.aab
dist/

# Local scratch + logs
/scratch/
*.log
.DS_Store
node_modules/
__pycache__/
*.pyc
