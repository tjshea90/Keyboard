<?xml version="1.0" encoding="utf-8"?>
<!-- Swoop keyboard. PERMISSIONS: INTERNET only (translate toolbar button, plan 9.2: only code in app.swoop.keyboard.translate may use the network, two hosts,
     HTTPS only); tools/expected-permissions.txt is the list CI compares the built APK against. No ACCESS_NETWORK_STATE. Exported components: the IME service (the system binds it, protected by BIND_INPUT_METHOD)
     and the setup activity (launcher + the keyboard's settings screen). Nothing else may be exported without a plan-9.2 reason. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/SwoopTheme"
        android:usesCleartextTraffic="false">

        <service
            android:name=".KeysService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <activity
            android:name=".SetupActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".DiagnosticsActivity"
            android:exported="false"
            android:label="@string/diag_title" />

    </application>

</manifest>
